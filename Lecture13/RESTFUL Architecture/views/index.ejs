<%- include("./partials/header") %>

    <main class="container w-50">

    <%for(let blog of blogs){ %>


        <div class="card mb-3 mt-4" style="width: 18rem;">
            <img src="<%=blog.imageUrl%>" class="card-img-top" alt="...">
            <div class="card-body">
              <h5 class="card-title"><%=blog.title%></h5>
              <p class="card-text"><%=blog.blogText%></p>
            </div>
           <a href="/blogs/<%=blog.id%>"><button style="background-color:green;">Show</button></a> 
          </div>


  <%}%>
</main>



<%- include("./partials/footer")  %> 